{
  "name": "live-staffing-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d dynamodb",
    "db:down": "docker compose down",
    "reset": "pnpm --filter @staffing/store reset",
    "dev": "pnpm --parallel --filter @staffing/functions --filter @staffing/web dev",
    "smoke:local": "pnpm --filter @staffing/infra smoke:live --base-url http://localhost:5173",
    "build:web": "pnpm --filter @staffing/web build",
    "deploy": "pnpm build:web && pnpm --filter @staffing/infra deploy:app",
    "deploy:hotswap": "pnpm build:web && pnpm --filter @staffing/infra deploy:hotswap",
    "destroy": "pnpm --filter @staffing/infra destroy:app",
    "bootstrap:aws": "pnpm --filter @staffing/infra bootstrap:aws"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.5"
  }
}
