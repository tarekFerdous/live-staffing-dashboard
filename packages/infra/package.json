{
  "name": "@staffing/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "deploy:app": "cdk deploy LiveStaffingApp --outputs-file cdk-outputs.json --require-approval never",
    "deploy:hotswap": "cdk deploy LiveStaffingApp --hotswap --outputs-file cdk-outputs.json",
    "destroy:app": "cdk destroy LiveStaffingApp --force",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "bootstrap:aws": "cdk deploy --app \"tsx bin/bootstrap.ts\" --profile staffing --require-approval never --outputs-file bootstrap-outputs.json && tsx scripts/cdk-bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/util-dynamodb": "^3.716.0",
    "@staffing/store": "workspace:*",
    "aws-cdk-lib": "^2.173.2",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.173.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2"
  }
}
